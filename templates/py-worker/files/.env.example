# Copy to .env.

# Absolute path to this project. input/, output/ and logs/ are resolved
# beneath it, so a relative value silently writes to the wrong place.
HOME_PATH=""

# The same database your API owns. The SQLAlchemy models here are hand-written
# and must be kept in step with its schema by hand — nothing checks this.
DB_HOST="localhost"
DB_PORT=5432
DB_USER="root"
DB_PASSWORD="postgres"
DB_NAME="main"

# The same Redis your API produces jobs to. A mismatch is silent: the worker
# connects fine and simply never receives anything.
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=""
# @feature:start telemetry

# OpenTelemetry → OpenObserve: traces, logs and metrics. Leave empty and
# telemetry stays off. Per project: OPENOBSERVE_ORG is the organization
# identifier, OPENOBSERVE_TOKEN its ingestion token (IAM → Ingestion Tokens).
# Any other OTLP backend: set OTEL_EXPORTER_OTLP_ENDPOINT/HEADERS instead.
OPENOBSERVE_URL="https://o2.aurostack.co"
OPENOBSERVE_ORG=""
OPENOBSERVE_TOKEN=""
OTEL_SERVICE_NAME="acme"
# @feature:end

# @feature:start temporal
# Temporal: this process also runs the workflows in temporal/. Locally, the
# API's dev server (its compose.yml; UI on http://localhost:8233), no TLS. In
# production, the server address, the project's namespace and its mTLS client
# certificate (plus the CA that signed the server's), as PEM. Escaped \n are
# accepted, so each fits on one line.
TEMPORAL_ADDRESS="localhost:7233"
TEMPORAL_NAMESPACE="default"
# The queue this worker polls. Its own, not the Node worker's: a workflow task
# handed to a worker that doesn't know the type fails and retries. Start
# Python workflows on this queue.
TEMPORAL_TASK_QUEUE="python"
TEMPORAL_TLS_CA=""
TEMPORAL_TLS_CERT=""
TEMPORAL_TLS_KEY=""
# @feature:end
