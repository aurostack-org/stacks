{
	"name": "acme-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "yarn@4.5.3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
		"preview": "vite preview",
		"lint": "eslint .",
		"typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
		"prepare": "husky",
		"secrets": "secrets",
		"gen:schema": "node .bin/openapi.js",
		"gen:types": "openapi-ts",
		"gen": "node .bin/openapi.js && openapi-ts"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,json,md,css}": "prettier --write"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@openobserve/browser-logs": "^0.4.3",
		"@openobserve/browser-rum": "^0.4.3",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-popover": "^1.1.21",
		"@radix-ui/react-select": "^2.3.4",
		"@radix-ui/react-slot": "^1.2.5",
		"@reduxjs/toolkit": "^2.12.0",
		"apexcharts": "^6.5.0",
		"better-auth": "^1.6.2",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"date-fns": "^3",
		"formik": "^2.4.9",
		"lucide-react": "^1.17.0",
		"react": "^19.2.6",
		"react-apexcharts": "^2.1.1",
		"react-day-picker": "^9",
		"react-dom": "^19.2.6",
		"react-redux": "^9.3.0",
		"react-router": "^8.2.0",
		"socket.io-client": "^4.8.1",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"zod": "^4.4.3",
		"zod-formik-adapter": "^2.0.0"
	},
	"devDependencies": {
		"@aurostack/secrets": "^0.1.1",
		"@eslint/js": "^10.0.1",
		"@hey-api/client-fetch": "^0.5.2",
		"@hey-api/openapi-ts": "^0.59.1",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.10.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"axios": "^1.7.9",
		"dotenv": "^16.4.7",
		"eslint": "^10.3.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-react-refresh": "^0.5.2",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.3.0",
		"prettier": "^3.4.2",
		"tiny-invariant": "^1.3.3",
		"typescript": "~6.0.2",
		"typescript-eslint": "^8.59.2",
		"vite": "^8.0.12",
		"vite-plugin-pwa": "^1.3.0"
	},
	"resolutions": {
		"typescript": "~6.0.2"
	}
}
