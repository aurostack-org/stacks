{
	"name": "acme-site",
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
		"dc:down": "docker compose down",
		"dc:up": "docker compose up -d",
		"dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
		"env:init": "node .bin/init-env.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
		"generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
		"lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
		"lint:fix": "cross-env NODE_OPTIONS=--no-deprecation eslint . --fix",
		"payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
		"prepare": "husky",
		"secrets": "secrets",
		"start": "cross-env NODE_OPTIONS=--no-deprecation next start",
		"test": "yarn test:int && yarn test:e2e",
		"test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
		"test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fontsource-variable/inter": "^5.3.0",
		"@openobserve/browser-logs": "^0.4.3",
		"@openobserve/browser-rum": "^0.4.3",
		"@opentelemetry/auto-instrumentations-node": "^0.80.0",
		"@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
		"@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
		"@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
		"@opentelemetry/resources": "^2.11.0",
		"@opentelemetry/sdk-logs": "^0.222.0",
		"@opentelemetry/sdk-metrics": "^2.11.0",
		"@opentelemetry/sdk-node": "^0.222.0",
		"@opentelemetry/semantic-conventions": "^1.43.0",
		"@payloadcms/admin-bar": "3.93.0",
		"@payloadcms/db-postgres": "3.93.0",
		"@payloadcms/email-nodemailer": "3.93.0",
		"@payloadcms/live-preview-react": "3.93.0",
		"@payloadcms/next": "3.93.0",
		"@payloadcms/plugin-ecommerce": "3.93.0",
		"@payloadcms/plugin-form-builder": "3.93.0",
		"@payloadcms/plugin-redirects": "3.93.0",
		"@payloadcms/plugin-search": "3.93.0",
		"@payloadcms/plugin-seo": "3.93.0",
		"@payloadcms/richtext-lexical": "3.93.0",
		"@payloadcms/ui": "3.93.0",
		"@radix-ui/react-checkbox": "^1.1.4",
		"@radix-ui/react-dialog": "^1.1.14",
		"@radix-ui/react-label": "^2.1.2",
		"@radix-ui/react-select": "^2.1.6",
		"@radix-ui/react-slot": "^1.1.2",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.0",
		"cross-env": "^7.0.3",
		"date-fns": "^4.1.0",
		"dotenv": "^8.2.0",
		"embla-carousel-auto-scroll": "^8.1.5",
		"embla-carousel-react": "^8.5.2",
		"graphql": "^16.8.2",
		"lucide-react": "0.563.0",
		"next": "16.4.5",
		"nodemailer": "^10.1.1",
		"payload": "3.93.0",
		"prism-react-renderer": "^2.3.1",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"react-hook-form": "7.71.1",
		"sharp": "0.35.4",
		"sonner": "^1.7.2",
		"tailwind-merge": "^3.4.0"
	},
	"devDependencies": {
		"@aurostack/secrets": "^0.1.1",
		"@playwright/test": "1.63.0",
		"@tailwindcss/postcss": "4.1.18",
		"@tailwindcss/typography": "^0.5.19",
		"@types/node": "22.19.9",
		"@types/nodemailer": "^8.0.2",
		"@types/react": "19.2.14",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "4.5.2",
		"eslint": "^9.16.0",
		"eslint-config-next": "16.4.5",
		"eslint-plugin-react-hooks": "^5.2.0",
		"husky": "^9.1.7",
		"jsdom": "28.0.0",
		"lint-staged": "^15.2.2",
		"postcss": "^8.5.28",
		"prettier": "^3.4.2",
		"tailwindcss": "^4.1.18",
		"tsx": "4.23.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "5.7.2",
		"vite-tsconfig-paths": "6.0.5",
		"vitest": "4.0.18"
	},
	"engines": {
		"node": ">=24"
	},
	"private": true,
	"packageManager": "yarn@4.5.3",
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,json,md,css,scss}": "prettier --write"
	}
}
