# Copy to .env. Only NEXT_PUBLIC_* variables reach the browser, and they are
# inlined at build time; everything else stays on the server.

# Postgres, from compose.yml.
DATABASE_URL='postgres://root:postgres@localhost:5432/main'

# Signs Payload's session tokens. Any long random string; changing it signs
# everyone out. Generate one with: openssl rand -hex 32
PAYLOAD_SECRET=''

# The site's public origin, used for absolute links (emails, SEO, previews).
NEXT_PUBLIC_SERVER_URL='http://localhost:3000'

# Lets the admin's live preview open drafts. Any random string.
PREVIEW_SECRET=''

# Outgoing email. The compose stack's Mailpit catches everything sent to
# localhost:1025 (UI on http://localhost:8025). Leave SMTP_HOST empty and
# emails are written to the server log instead of sent.
SMTP_HOST='localhost'
SMTP_PORT='1025'
SMTP_USER=''
SMTP_PASS=''
MAIL_FROM_ADDRESS='no-reply@example.com'
MAIL_FROM_NAME='Acme Corp'

# Shown in the footer and SEO metadata.
COMPANY_NAME='Acme Corp'
SITE_NAME='Acme Corp'

# Where uploaded media is stored. Defaults to ./media; the Docker image uses
# /app/media, which should be a volume.
MEDIA_DIR=''

# @feature:start telemetry
# OpenTelemetry → OpenObserve (server): traces, logs and metrics. Leave empty
# and telemetry stays off. OPENOBSERVE_TOKEN is the org's ingestion token
# (IAM → Ingestion Tokens, o2oi_…). Any other OTLP backend: set
# OTEL_EXPORTER_OTLP_ENDPOINT/HEADERS instead.
OPENOBSERVE_URL='https://o2.aurostack.co'
OPENOBSERVE_ORG=''
OPENOBSERVE_TOKEN=''
OTEL_SERVICE_NAME='acme-site'

# Browser monitoring (RUM). The client token is a RUM token (Ingestion → RUM):
# write-only and meant to ship in the bundle — never the ingestion token above.
# The instance must list this site's origin in ZO_CORS_ALLOWED_ORIGINS.
NEXT_PUBLIC_OPENOBSERVE_URL='https://o2.aurostack.co'
NEXT_PUBLIC_OPENOBSERVE_ORG=''
NEXT_PUBLIC_OPENOBSERVE_CLIENT_TOKEN=''
# @feature:end
