{
	"name": "collector",
	"version": "1.0.0",
	"type": "module",
	"main": "dist/src/index.js",
	"license": "MIT",
	"imports": {
		"#app/*": {
			"development": "./src/*",
			"default": "./dist/src/*"
		},
		"#prisma/*": {
			"development": "./prisma/generated/*",
			"default": "./dist/prisma/generated/*"
		},
		"#utils/*": {
			"development": "./src/utils/*",
			"default": "./dist/src/utils/*"
		},
		"#lib/*": {
			"development": "./src/lib/*",
			"default": "./dist/src/lib/*"
		}
	},
	"scripts": {
		"dev": "tsx --conditions=development src/index.ts",
		"dev:watch": "tsx watch --conditions=development src/index.ts",
		"build": "tsc",
		"start": "node dist/src/index.js",
		"secrets": "tsx --conditions=development .bin/secrets",
		"db:generate": "tsx --conditions=development ./.bin/db.ts",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"dependencies": {
		"@paralleldrive/cuid2": "^3.3.0",
		"@prisma/adapter-pg": "^7.8.0",
		"@prisma/client": "^7.8.0",
		"bullmq": "^5.79.2",
		"dotenv": "^17.4.2",
		"moment": "^2.30.1",
		"pino": "^10.3.1",
		"puppeteer": "^25.3.0",
		"shelljs": "^0.10.0",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.1.0",
		"@types/shelljs": "^0.10.0",
		"@types/yargs": "^17.0.35",
		"eslint": "^10.6.0",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.7.0",
		"pino-pretty": "^13.1.3",
		"prettier": "^3.9.4",
		"prisma": "^7.8.0",
		"prisma-dbml-generator": "^0.12.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.62.1"
	}
}
