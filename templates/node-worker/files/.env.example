# Copy to .env.

APP_ENV='development'
LOG_LEVEL='debug'

# The same database your API uses — this worker talks to it directly rather
# than over HTTP, so the schema must match.
DATABASE_URL='postgresql://root:postgres@localhost:5432/main'

# The same Redis your API produces jobs to. A mismatch here is silent: the
# worker connects fine and simply never receives anything.
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_USER=''
REDIS_PASSWORD=''
# @feature:start telemetry

# OpenTelemetry → OpenObserve: traces, logs and metrics. Leave empty and
# telemetry stays off. Per project: OPENOBSERVE_ORG is the organization
# identifier, OPENOBSERVE_TOKEN its ingestion token (IAM → Ingestion Tokens).
# Any other OTLP backend: set OTEL_EXPORTER_OTLP_ENDPOINT/HEADERS instead.
OPENOBSERVE_URL='https://o2.aurostack.co'
OPENOBSERVE_ORG=''
OPENOBSERVE_TOKEN=''
OTEL_SERVICE_NAME='collector'
# @feature:end

# @feature:start temporal
# Temporal: this process also runs the workflows in src/temporal. Locally, the
# API's dev server (its compose.yml; UI on http://localhost:8233), no TLS. In
# production, the server address, the project's namespace and its mTLS client
# certificate (plus the CA that signed the server's), as PEM. Escaped \n are
# accepted, so each fits on one line.
TEMPORAL_ADDRESS='localhost:7233'
TEMPORAL_NAMESPACE='default'
# The queue this worker polls; must match where the API starts workflows (its
# TEMPORAL_TASK_QUEUE). A mismatch is silent: workflows just sit waiting.
TEMPORAL_TASK_QUEUE='main'
TEMPORAL_TLS_CA=''
TEMPORAL_TLS_CERT=''
TEMPORAL_TLS_KEY=''
# @feature:end

# @feature:start browser
# Empty = use Puppeteer's bundled Chromium. Set this in a slim container image
# where Chromium is installed separately.
PUPPETEER_EXECUTABLE_PATH=''
# @feature:end
