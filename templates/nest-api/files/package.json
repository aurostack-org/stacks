{
	"name": "@starter/backend",
	"version": "0.0.1",
	"description": "API service",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"start": "ts-node .bin/start.ts",
		"start:prod": "node dist/src/main",
		"build": "nest build",
		"gen": "nest generate",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
		"email:dev": "email dev -p 5003",
		"secrets": "ts-node .bin/secrets",
		"db:generate": "ts-node ./.bin/db.ts",
		"db:push": "ts-node ./.bin/db.ts -c push",
		"db:migrate:create": "prisma migrate dev --create-only",
		"db:migrate": "prisma migrate dev",
		"db:migrate:prod": "prisma migrate deploy",
		"db:seed": "ts-node ./.bin/db.ts -c seed",
		"db:reset": "ts-node ./.bin/db.ts -c reset",
		"db:studio": "ts-node ./.bin/db.ts -c studio",
		"test:db:generate": "ts-node ./.bin/db.ts -e test",
		"test:db:push": "ts-node ./.bin/db.ts -c push -e test",
		"test:db:seed": "ts-node ./.bin/db.ts -c seed -e test",
		"test": "dotenv -e .env.test -- vitest run --project unit",
		"test:watch": "dotenv -e .env.test -- vitest --project unit",
		"test:ui": "dotenv -e .env.test -- vitest --ui --project unit",
		"test:e2e": "dotenv -e .env.test -- vitest run --project e2e",
		"test:e2e:watch": "dotenv -e .env.test -- vitest --project e2e",
		"test:e2e:ui": "dotenv -e .env.test -- vitest --ui --project e2e",
		"test:cov": "dotenv -e .env.test -- vitest --coverage",
		"test:all": "dotenv -e .env.test -- vitest run",
		"test:all:ui": "dotenv -e .env.test -- vitest --ui",
		"dc:up": "ts-node ./.bin/dc.ts -c up",
		"dc:down": "ts-node ./.bin/dc.ts -c down",
		"dc:wait": "ts-node ./.bin/dc.ts -c wait",
		"dc:recreate": "ts-node ./.bin/dc.ts -c recreate",
		"dc:reinstall": "yarn dc:recreate && yarn db:generate && yarn db:migrate && yarn db:seed",
		"test:dc:up": "ts-node ./.bin/dc.ts -c up -e test",
		"test:dc:wait": "ts-node ./.bin/dc.ts -c wait -e test",
		"test:dc:down": "ts-node ./.bin/dc.ts -c down -e test",
		"test:dc:recreate": "ts-node ./.bin/dc.ts -c recreate -e test",
		"test:dc:reinstall": "yarn test:dc:recreate && yarn test:db:generate && yarn test:db:push && yarn test:db:seed",
		"down": "yarn dc:down && yarn test:dc:down",
		"reinstall": "yarn dc:reinstall && yarn test:dc:reinstall"
	},
	"dependencies": {
		"@apollo/server": "^4.11.0",
		"@aws-sdk/client-s3": "^3.1013.0",
		"@bull-board/api": "^5.6.0",
		"@bull-board/express": "^5.6.0",
		"@bull-board/nestjs": "^5.6.0",
		"@growthbook/growthbook": "^1.6.5",
		"@nestjs-modules/mailer": "^2.0.2",
		"@nestjs/apollo": "^13.2.3",
		"@nestjs/axios": "^3.0.0",
		"@nestjs/bullmq": "^10.0.1",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.0.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/graphql": "^13.2.3",
		"@nestjs/platform-express": "^10.0.5",
		"@nestjs/platform-socket.io": "^10",
		"@nestjs/schedule": "^6.1.3",
		"@nestjs/swagger": "^7.1.1",
		"@nestjs/terminus": "^10.0.1",
		"@nestjs/throttler": "^6.5.0",
		"@nestjs/websockets": "^10",
		"@paralleldrive/cuid2": "^3.3.0",
		"@prisma/adapter-pg": "^7.4.2",
		"@prisma/client": "^7.4.2",
		"@react-email/components": "^0.0.7",
		"@react-email/render": "^0.0.7",
		"@scalar/nestjs-api-reference": "^1.0.18",
		"@socket.io/redis-adapter": "^8",
		"@thallesp/nestjs-better-auth": "^2.5.4",
		"@willsoto/nestjs-prometheus": "^6.1.0",
		"axios": "^1.4.0",
		"better-auth": "^1.3.18",
		"bullmq": "^4.2.0",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.0",
		"express-basic-auth": "^1.2.1",
		"graphql": "^16.12.0",
		"helmet": "^7.0.0",
		"ioredis": "^5.4.1",
		"joi": "^17.9.2",
		"moment": "^2.29.4",
		"nestjs-pino": "^4.6.1",
		"nodemailer": "^6.9.3",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"prom-client": "^15.1.3",
		"randomstring": "^1.3.0",
		"react": "^18.2.0",
		"react-email": "^1.9.4",
		"reflect-metadata": "^0.1.13",
		"rxjs": "^7.8.1",
		"shelljs": "^0.10.0",
		"socket.io": "^4",
		"uuid": "^13.0.0",
		"yargs": "^18.0.0"
	},
	"devDependencies": {
		"@faker-js/faker": "^8.0.2",
		"@golevelup/ts-vitest": "^2.2.0",
		"@nestjs/cli": "^10.0.0",
		"@nestjs/schematics": "^10.0.0",
		"@nestjs/testing": "^10.0.0",
		"@suites/di.nestjs": "^3.0.1",
		"@suites/doubles.vitest": "^3.0.1",
		"@suites/unit": "^3.0.1",
		"@swc/core": "^1.15.18",
		"@types/express": "^4.17.17",
		"@types/multer": "^1.4.7",
		"@types/node": "^25.0.9",
		"@types/nodemailer": "^6.4.8",
		"@types/randomstring": "^1.1.8",
		"@types/react": "^18.2.14",
		"@types/shelljs": "^0.10.0",
		"@types/supertest": "^2.0.12",
		"@types/yargs": "^17.0.35",
		"@typescript-eslint/eslint-plugin": "^5.59.11",
		"@typescript-eslint/parser": "^5.59.11",
		"@vitest/coverage-v8": "^4.0.18",
		"@vitest/ui": "4.0.18",
		"cross-env": "^7.0.3",
		"dotenv-cli": "^7.2.1",
		"eslint": "^8.42.0",
		"eslint-config-prettier": "^8.8.0",
		"eslint-plugin-prettier": "^4.2.1",
		"fishery": "^2.2.2",
		"pino-pretty": "^13.1.3",
		"prettier": "^2.8.8",
		"prisma": "^7.4.2",
		"prisma-dbml-generator": "^0.12.0",
		"source-map-support": "^0.5.21",
		"supertest": "^6.3.3",
		"ts-loader": "^9.4.3",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"typescript": "^5.9.3",
		"unplugin-swc": "^1.5.9",
		"vitest": "^4.0.18"
	}
}
