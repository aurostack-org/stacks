datasource db {
  provider = "postgresql"
}

generator client {
  provider        = "prisma-client"
  output          = "../generated"
  moduleFormat    = "cjs"
  previewFeatures = ["views", "fullTextSearchPostgres"]
}

generator dbml {
  provider            = "prisma-dbml-generator"
  output              = "../"
  projectName         = "InvestmentNerds"
  projectDatabaseType = "PostgreSQL"
}
