model Notification {
  id        String           @id(map: "notifications_pk") @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  data      Json
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade, map: "notifications_user_fk")

  @@index([userId, readAt], map: "notifications_user_read_idx")
  @@index([userId, createdAt], map: "notifications_user_created_idx")
  @@map("notifications")
}
