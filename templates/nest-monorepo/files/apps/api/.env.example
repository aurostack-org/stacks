# Copy to .env and fill in. Every variable here is validated at boot by
# src/common/services/config.service.ts — the process refuses to start if a
# required one is missing, rather than failing later inside a request.

APP_ENV='development'
APP_NAME='Acme Corp'
APP_HOST='0.0.0.0'
PORT='5000'
SERVER_HOST='http://localhost:5000'
FRONTEND_HOST='http://localhost:3000'
# Extra origins beyond FRONTEND_HOST, comma separated, trusted by auth and
# allowed by CORS: every react-monorepo app goes here or in FRONTEND_HOST. A full
# origin (`http://localhost:3001`) is used as written; a bare hostname
# (`example.com`) expands to https://example.com and its auth., app. and admin.
# subdomains.
MISC_CORS_ORIGINS=''

DATABASE_URL='postgresql://root:postgres@localhost:5432/main'

# openssl rand -base64 32
BETTER_AUTH_SECRET='change-me-openssl-rand-base64-32'
BETTER_AUTH_URL='http://localhost:5000'
# Empty: the session cookie belongs to the API's own host, which is what
# localhost development and a single-origin frontend need. Set a parent domain
# with a leading dot (`.example.com`) when frontends live on subdomains, to share
# one login across them; locally, `.lvh.me` does the same with `*.lvh.me` hosts
# (every subdomain resolves to 127.0.0.1). The domain must cover the host the
# browser talks to, or the cookie is dropped and every sign-in bounces.
BETTER_AUTH_COOKIE_DOMAIN=''
BETTER_AUTH_COOKIE_PREFIX='acme'

# Seeded by `yarn db:seed`.
SUPERUSER_EMAIL='admin@example.com'
SUPERUSER_PASSWORD='Secret@1'

OAUTH_GOOGLE_CLIENT_ID=''
OAUTH_GOOGLE_CLIENT_SECRET=''

LOG_LEVEL='debug'

# @feature:start observability
# OpenTelemetry → OpenObserve: traces, logs and metrics. Leave empty and
# telemetry stays off (local development, tests). Per project:
#   OPENOBSERVE_ORG    the project's organization identifier
#   OPENOBSERVE_TOKEN  that org's ingestion token (IAM → Ingestion Tokens, o2oi_…)
# OPENOBSERVE_STREAM defaults to the service name (OTEL_SERVICE_NAME).
# Any other OTLP backend: set OTEL_EXPORTER_OTLP_ENDPOINT/HEADERS instead.
OPENOBSERVE_URL='https://o2.aurostack.co'
OPENOBSERVE_ORG=''
OPENOBSERVE_TOKEN=''
OTEL_SERVICE_NAME='acme'

# Limits past which /health reports down. Size them to the container's real
# limits: an orchestrator restarts instances that fail this check.
HEALTH_HEAP_MAX_MB='300'
HEALTH_RSS_MAX_MB='300'
# Fraction (0–1) of HEALTH_DISK_PATH's volume that may be used.
HEALTH_DISK_THRESHOLD='0.8'
HEALTH_DISK_PATH='/'
# @feature:end

# @feature:start openapi, queue
# Guards /docs, /openapi-json and /dashboard.
BASIC_AUTH_USER='admin'
BASIC_AUTH_PASS='Secret@1'
# @feature:end

# @feature:start cache
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_USER=''
REDIS_PASSWORD=''
# @feature:end

# @feature:start mail
SMTP_HOST='smtp.example.com'
SMTP_PORT='465'
SMTP_SECURE='true'
SMTP_USER=''
SMTP_PASSWORD=''
SMTP_FROM='Acme Corp <no-reply@example.com>'
SMTP_SUPPORT_EMAIL='support@example.com'
# @feature:end

# @feature:start media
S3_REGION='us-east-1'
# Leave empty for AWS; set it for MinIO or another S3-compatible host.
S3_ENDPOINT=''
S3_BUCKET_NAME='acme'
S3_ACCESS_KEY_ID=''
S3_SECRET_ACCESS_KEY=''
# @feature:end

# @feature:start temporal
# Temporal: durable workflows. Locally, the dev server in compose.yml (no TLS;
# UI on http://localhost:8233). In production, the server address, the
# project's namespace and its mTLS client certificate (plus the CA that signed
# the server's), as PEM. Escaped \n are accepted, so each fits on one line.
TEMPORAL_ADDRESS='localhost:7233'
TEMPORAL_NAMESPACE='default'
# Where workflows started here are queued. The worker that runs them must poll
# the same queue (its TEMPORAL_TASK_QUEUE); a mismatch is silent, workflows
# just sit waiting.
TEMPORAL_TASK_QUEUE='main'
TEMPORAL_TLS_CA=''
TEMPORAL_TLS_CERT=''
TEMPORAL_TLS_KEY=''
# @feature:end

# @feature:start rate-limit
RATE_LIMIT_ENABLED='true'
# Throttler TTLs are in milliseconds.
RATE_LIMIT_TTL='60000'
RATE_LIMIT_MAX='120'
# better-auth's own window is in seconds.
RATE_LIMIT_AUTH_WINDOW='10'
RATE_LIMIT_AUTH_MAX='100'
# Load-bearing behind a proxy: if no IP can be resolved, better-auth skips rate
# limiting entirely and only warns.
RATE_LIMIT_IP_HEADERS='x-forwarded-for'
# @feature:end

# @feature:start feature-flags
GROWTHBOOK_API_HOST=''
GROWTHBOOK_CLIENT_KEY=''
# @feature:end
