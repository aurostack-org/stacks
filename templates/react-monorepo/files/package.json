{
	"name": "acme-frontend",
	"private": true,
	"version": "0.0.0",
	"packageManager": "yarn@4.5.3",
	"engines": {
		"node": ">=24"
	},
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"lint": "turbo run lint",
		"typecheck": "turbo run typecheck",
		"format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,md,css}\"",
		"prepare": "husky",
		"secrets": "turbo run secrets"
	},
	"lint-staged": {
		"*.{ts,tsx,js,jsx,mjs,json,md,css}": "prettier --write"
	},
	"devDependencies": {
		"eslint": "^10.3.0",
		"husky": "^9.1.7",
		"lint-staged": "^15.3.0",
		"prettier": "^3.4.2",
		"turbo": "^2.5.3",
		"typescript": "~6.0.2"
	},
	"resolutions": {
		"typescript": "~6.0.2"
	}
}
