# Copy to .env. Vite only exposes variables prefixed VITE_, and inlines them at
# build time — never put a secret here, it ships to the browser.

# Backend base URL. Better Auth lives at ${VITE_APP_API_URL}/auth.
VITE_APP_API_URL='http://localhost:5000'

# Sibling app origins. All four share one session cookie across subdomains, so
# these must agree with the backend's BETTER_AUTH_COOKIE_DOMAIN and its
# trustedOrigins list, or login will appear to succeed and then bounce.
VITE_APP_LANDING='http://localhost:3000'
VITE_APP_AUTH_HOST='http://localhost:3001'
VITE_APP_CLIENT_HOST='http://localhost:3002'
VITE_APP_ADMIN_HOST='http://localhost:3003'

# This app's own dev port.
PORT='3000'

# Canonical public URL, used for sitemap/robots/OG tags at build time.
VITE_APP_SITE_URL='http://localhost:3000'
VITE_APP_SUPPORT_EMAIL='support@example.com'
