# The CLI has no dependencies and no build step, and the templates are source
# only — nothing in this repo is generated. These rules exist to keep an
# accidental local install or build inside a template's files/ tree from being
# committed as if it were part of the template.
node_modules/
.yarn/
dev-dist/
*.tsbuildinfo

# Belt and braces. Templates ship `.env.example` files and never a real `.env`;
# `stack extract` excludes `.env*` from every source repo for that reason, and
# this is the second line of defence if one is ever created in place.
.env
.env.*
!*.example

# OS / editor
.DS_Store
*.log

# Maintainer-only extraction config (source paths, include/exclude, identifier map).
stacks.local.json
__pycache__/

# next-site is maintained by running it in place (templates/next-site/README.md).
# What a dev run, a build and a seed leave behind; scoped, because a bare
# `media/` would also hide nest-api's src/media.
templates/next-site/files/.next/
templates/next-site/files/media/
templates/next-site/files/AGENTS.md
templates/next-site/files/next-env.d.ts
templates/next-site/files/yarn.lock
